
#include <stdio.h>
#include <limits.h>

#define N 4

int cost[N][N] = {
    {0, 10, 15, 20},
    {10, 0, 35, 25},
    {15, 35, 0, 30},
    {20, 25, 30, 0}
};

int visited[N] = {0};
int minCost = INT_MAX;

void tsp(int city, int count, int totalCost) {
    if (count == N) {
        if (cost[city][0] != 0) {
            int finalCost = totalCost + cost[city][0];

            if (finalCost < minCost)
                minCost = finalCost;
        }
        return;
    }

    for (int i = 0; i < N; i++) {
        if (!visited[i] && cost[city][i] != 0) {
            visited[i] = 1;

            tsp(i, count + 1,
                totalCost + cost[city][i]);

            visited[i] = 0;
        }
    }
}

int main() {
    visited[0] = 1;

    tsp(0, 1, 0);

    printf("Minimum travel cost = %d\n", minCost);

    return 0;
}
