
#include <stdio.h>

#define N 4
#define INF 99999

int main() {
    int a[N][N] = {
        {0,   5, INF, 10},
        {INF, 0,   3, INF},
        {INF, INF, 0,   1},
        {INF, INF, INF, 0}
    };

    int i = 0, j, k;

    while (i < N) {
        j = 0;

        while (j < N) {
            k = 0;

            while (k < N) {
                if (a[j][i] != INF &&
                    a[i][k] != INF &&
                    a[j][i] + a[i][k] < a[j][k]) {

                    a[j][k] = a[j][i] + a[i][k];
                }

                k++;
            }

            j++;
        }

        i++;
    }

    printf("Shortest Distance Matrix:\n");

    for (i = 0; i < N; i++) {
        for (j = 0; j < N; j++) {
            if (a[i][j] == INF)
                printf("INF ");
            else
                printf("%d ", a[i][j]);
        }
        printf("\n");
    }

    return 0;
}
